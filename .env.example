# Optional settings for PostedFresh. Copy this file to .env to change the defaults.

# MAX_JOB_AGE_DAYS=45

# Add or remove company career boards (comma-separated board slugs).
# Find a slug in a company's careers URL, e.g. boards.greenhouse.io/<slug>, jobs.lever.co/<slug>,
# jobs.ashbyhq.com/<slug>, jobs.smartrecruiters.com/<slug>
# GREENHOUSE_BOARDS=stripe,airbnb,discord
# LEVER_BOARDS=spotify,palantir
# ASHBY_BOARDS=openai,notion,ramp
# SMARTRECRUITERS_COMPANIES=BoschGroup,McDonaldsCorporation
